{
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "node --import tsx --test tests/integration/*.test.js",
    "test:requirements": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.js",
    "test:requirements:rules": "node --import tsx --test --test-concurrency=1 tests/integration/bids-flow.test.js tests/integration/bids-concurrency.test.js tests/integration/bid-idempotency.test.js tests/integration/wallets.test.js tests/integration/settlements.test.js",
    "test:requirements:audit": "node --import tsx --test --test-concurrency=1 tests/integration/audit-public.test.js tests/integration/audit-adversarial.test.js tests/integration/cryptographic-binding.test.js tests/integration/recovery.test.js tests/integration/receipts.test.js",
    "dev": "tsx watch src/server.ts",
    "audit:witness": "tsx src/modules/audit/witness/main.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/shared/database/run-seed.ts",
    "demo:recovery:isolated": "node --import tsx scripts/demo-recovery.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
